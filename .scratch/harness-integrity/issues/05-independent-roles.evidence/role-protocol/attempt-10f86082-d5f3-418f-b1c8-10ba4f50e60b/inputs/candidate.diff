+  const makeDirectoriesReadOnly = async (root) => {
+    for (const entry of await readdir(root, { withFileTypes: true })) {
+      if (entry.isDirectory()) await makeDirectoriesReadOnly(join(root, entry.name));
+    }
+    await chmod(root, 0o555);
+  };
