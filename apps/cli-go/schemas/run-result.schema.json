{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-prompt.dev/schema/run-result-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "runId",
    "recipe",
    "status",
    "alternatives",
    "exposed",
    "assumptions",
    "clarifications",
    "diagnostics",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runId": { "type": "string", "minLength": 1 },
    "recipe": { "$ref": "#/$defs/lockedRecipe" },
    "status": { "enum": ["success", "degraded", "blocked", "cancelled", "failed"] },
    "primary": { "$ref": "#/$defs/artifact" },
    "primaryOrigin": { "enum": ["transformed", "original"] },
    "alternatives": { "type": "array", "items": { "$ref": "#/$defs/artifact" } },
    "exposed": {
      "type": "object",
      "propertyNames": { "$ref": "#/$defs/namespacedId" },
      "additionalProperties": {
        "type": "array",
        "items": { "$ref": "#/$defs/artifact" }
      }
    },
    "assumptions": { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
    "clarifications": { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
    "diagnostics": { "type": "array", "items": { "$ref": "#/$defs/diagnostic" } },
    "summary": { "$ref": "#/$defs/runSummary" }
  },
  "$defs": {
    "namespacedId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9._-]*/[A-Za-z][A-Za-z0-9._-]*(?:/[A-Za-z0-9._-]+)*$"
    },
    "jsonValue": {
      "oneOf": [
        { "type": "null" },
        { "type": "boolean" },
        { "type": "number" },
        { "type": "string" },
        { "type": "array", "items": { "$ref": "#/$defs/jsonValue" } },
        { "type": "object", "additionalProperties": { "$ref": "#/$defs/jsonValue" } }
      ]
    },
    "lockedRecipe": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "version"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "schemaReference": {
      "type": "object",
      "additionalProperties": false,
      "required": ["uri"],
      "properties": { "uri": { "type": "string", "minLength": 1 } }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "pluginId",
        "contributionId",
        "invocationId",
        "phase",
        "parentArtifactIds",
        "patchIds"
      ],
      "properties": {
        "pluginId": { "type": "string", "minLength": 1 },
        "contributionId": { "type": "string", "minLength": 1 },
        "invocationId": { "type": "string", "minLength": 1 },
        "phase": {
          "enum": ["preflight", "analyze", "transform", "adapt", "validate", "render"]
        },
        "parentArtifactIds": { "type": "array", "items": { "type": "string" } },
        "patchIds": { "type": "array", "items": { "type": "string" } },
        "modelCallRef": { "type": "string", "minLength": 1 }
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schemaVersion",
        "id",
        "kind",
        "mediaType",
        "value",
        "provenance",
        "classification"
      ],
      "properties": {
        "schemaVersion": { "const": "1" },
        "id": { "type": "string", "minLength": 1 },
        "kind": { "$ref": "#/$defs/namespacedId" },
        "mediaType": { "type": "string", "minLength": 1 },
        "value": { "$ref": "#/$defs/jsonValue" },
        "dataSchema": { "$ref": "#/$defs/schemaReference" },
        "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
        "provenance": { "$ref": "#/$defs/provenance" },
        "classification": { "enum": ["public", "internal", "sensitive"] },
        "extensions": {
          "type": "object",
          "propertyNames": { "$ref": "#/$defs/namespacedId" },
          "additionalProperties": { "$ref": "#/$defs/jsonValue" }
        }
      }
    },
    "diagnostic": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schemaVersion", "id", "code", "category", "severity", "title"],
      "properties": {
        "schemaVersion": { "const": "1" },
        "id": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "minLength": 1 },
        "category": { "type": "string", "minLength": 1 },
        "severity": { "enum": ["info", "warning", "error", "fatal"] },
        "title": { "type": "string", "minLength": 1 },
        "detail": { "type": "string" }
      }
    },
    "runSummary": {
      "type": "object",
      "additionalProperties": false,
      "required": ["traceId", "durationMs", "completedPhases", "failedPhases"],
      "properties": {
        "traceId": { "type": "string", "minLength": 1 },
        "durationMs": { "type": "number", "minimum": 0 },
        "completedPhases": {
          "type": "array",
          "items": {
            "enum": ["preflight", "analyze", "transform", "adapt", "validate", "render"]
          }
        },
        "failedPhases": {
          "type": "array",
          "items": {
            "enum": ["preflight", "analyze", "transform", "adapt", "validate", "render"]
          }
        }
      }
    }
  }
}
