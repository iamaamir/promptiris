{
  "name": "@meta-prompt/runtime-node",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./native-plugin": {
      "types": "./dist/native-plugin.d.ts",
      "default": "./dist/native-plugin.js"
    }
  },
  "bin": {
    "meta-prompt-runtime": "dist/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@meta-prompt/core": "workspace:*",
    "@meta-prompt/plugin-sdk": "workspace:*",
    "@meta-prompt/protocol": "workspace:*"
  }
}
