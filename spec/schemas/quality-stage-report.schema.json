{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promptiris:schema:quality-stage-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "role",
    "taskId",
    "baseRevision",
    "candidateRevision",
    "producerId",
    "status",
    "scenarios",
    "evidence"
  ],
  "oneOf": [
    {
      "properties": {
        "role": { "const": "hardener" },
        "sourceBlind": { "type": "boolean" }
      }
    },
    {
      "required": ["sourceBlind"],
      "properties": {
        "role": { "const": "qa" },
        "sourceBlind": { "const": true }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "role": { "enum": ["hardener", "qa"] },
    "taskId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
    "candidateRevision": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "producerId": { "type": "string", "minLength": 1 },
    "status": { "enum": ["passed", "failed"] },
    "sourceBlind": { "type": "boolean" },
    "scenarios": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "evidence": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "evidenceRef", "evidenceSha256"],
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed"] },
          "evidenceRef": { "type": "string", "minLength": 1 },
          "evidenceSha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        }
      }
    }
  }
}
