{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-prompt.dev/schema/harness-work-item-v1.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "task_id", "goal", "stage", "iteration", "next_action"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "task_id": { "type": "string", "minLength": 1 },
    "goal": { "type": "string", "minLength": 1 },
    "stage": { "enum": ["generator", "cleaner", "hardener", "qa", "integration"] },
    "iteration": { "type": "number", "minimum": 0 },
    "last_verification": { "type": "string" },
    "next_action": { "type": "string", "minLength": 1 },
    "lease": { "type": "object" }
  }
}
