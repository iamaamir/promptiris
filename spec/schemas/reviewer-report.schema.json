{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promptiris:schema:reviewer-report:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "baseRevision",
    "candidateRevision",
    "verdict",
    "findings",
    "commentDecisions",
    "evidence",
    "residualRisks"
  ],
  "oneOf": [
    {
      "properties": {
        "verdict": { "const": "pass" },
        "findings": { "type": "array", "maxItems": 0 }
      }
    },
    {
      "properties": {
        "verdict": { "const": "changes-required" },
        "findings": { "type": "array", "minItems": 1 }
      }
    }
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "string", "minLength": 1 },
    "candidateRevision": { "type": "string", "minLength": 1 },
    "verdict": { "enum": ["pass", "changes-required"] },
    "findings": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "severity", "file", "line", "summary", "evidenceRef"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "severity": { "enum": ["blocker", "high", "medium", "low"] },
          "file": { "type": "string", "minLength": 1 },
          "line": { "type": "integer", "minimum": 1 },
          "summary": { "type": "string", "minLength": 1 },
          "evidenceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "commentDecisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["commentId", "disposition", "reason", "evidenceRef"],
        "properties": {
          "commentId": { "type": "string", "minLength": 1 },
          "disposition": { "enum": ["accepted", "rejected"] },
          "reason": { "type": "string", "minLength": 1 },
          "evidenceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["checkId", "status", "evidenceRef"],
        "properties": {
          "checkId": { "type": "string", "minLength": 1 },
          "status": { "enum": ["passed", "failed", "deferred"] },
          "evidenceRef": { "type": "string", "minLength": 1 }
        }
      }
    },
    "residualRisks": { "type": "array", "items": { "type": "string", "minLength": 1 } }
  }
}
