{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:promptiris:schema:role-input-manifest:v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "taskId",
    "baseRevision",
    "candidateRevision",
    "promptRef",
    "promptId",
    "promptDigest",
    "producerId",
    "implementerId",
    "parentInvocationId",
    "attemptId",
    "role",
    "modelClass",
    "sourceAccessMode",
    "inputs",
    "manifestDigest"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "taskId": { "type": "string", "minLength": 1 },
    "baseRevision": { "type": "string", "minLength": 1 },
    "candidateRevision": { "type": "string", "minLength": 1 },
    "promptRef": { "type": "string", "minLength": 1 },
    "promptId": { "type": "string", "minLength": 1 },
    "promptDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
    "producerId": { "type": "string", "minLength": 1 },
    "implementerId": { "type": "string", "minLength": 1 },
    "parentInvocationId": { "type": "string", "minLength": 1 },
    "attemptId": { "type": "string", "minLength": 1 },
    "role": { "enum": ["reviewer", "hardener", "qa"] },
    "modelClass": { "enum": ["quick", "general", "frontier"] },
    "sourceAccessMode": {
      "enum": ["contract-diff", "attack-surfaces", "source-blind-bundle"]
    },
    "inputs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "ref", "digest"],
        "properties": {
          "kind": {
            "enum": [
              "work-item",
              "candidate-diff",
              "reviewer-context",
              "attack-surfaces",
              "source-blind-bundle"
            ]
          },
          "ref": { "type": "string", "minLength": 1 },
          "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" },
          "surfaces": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["path", "class", "origin"],
              "properties": {
                "path": { "type": "string", "minLength": 1 },
                "class": {
                  "enum": [
                    "verifier-or-policy",
                    "protocol-or-kernel",
                    "runtime-or-plugin",
                    "security-or-concurrency",
                    "test-or-fixture",
                    "changed-surface"
                  ]
                },
                "origin": { "enum": ["changed", "dependent"] }
              }
            }
          },
          "context": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "schemaVersion",
              "complete",
              "affectedSurfaces",
              "deterministicEvidence",
              "candidate"
            ],
            "properties": {
              "schemaVersion": { "const": 1 },
              "complete": { "const": true },
              "affectedSurfaces": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "class", "origin"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "class": {
                      "enum": [
                        "verifier-or-policy",
                        "protocol-or-kernel",
                        "runtime-or-plugin",
                        "security-or-concurrency",
                        "test-or-fixture",
                        "changed-surface"
                      ]
                    },
                    "origin": { "enum": ["changed", "dependent"] }
                  }
                }
              },
              "deterministicEvidence": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["taskId", "providerId", "dirty"],
                  "properties": {
                    "taskId": { "type": "string", "minLength": 1 },
                    "providerId": { "type": "string", "minLength": 1 },
                    "evidenceRef": { "type": "string", "minLength": 1 },
                    "evidenceDigest": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
                    "dirty": { "type": "boolean" }
                  }
                }
              },
              "candidate": {
                "type": "object",
                "additionalProperties": false,
                "required": ["baseRevision", "headRevision", "candidateRevision"],
                "properties": {
                  "baseRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "headRevision": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
                  "candidateRevision": {
                    "type": "string",
                    "pattern": "^sha256:[0-9a-f]{64}$"
                  }
                }
              }
            }
          },
          "bundle": {
            "type": "object",
            "additionalProperties": false,
            "required": ["root", "files", "capabilities"],
            "properties": {
              "root": { "type": "string", "minLength": 1 },
              "files": {
                "type": "array",
                "items": {
                  "type": "object",
                  "additionalProperties": false,
                  "required": ["path", "digest"],
                  "properties": {
                    "path": { "type": "string", "minLength": 1 },
                    "digest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
                  }
                }
              },
              "capabilities": {
                "type": "object",
                "additionalProperties": { "type": "boolean" }
              }
            }
          }
        }
      }
    },
    "manifestDigest": { "type": "string", "pattern": "^sha256:[0-9a-f]{64}$" }
  }
}
