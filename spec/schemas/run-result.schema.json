{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://meta-prompt.dev/schema/run-result-v1.json",
  "type": "object",
  "required": [
    "schemaVersion",
    "runId",
    "recipe",
    "status",
    "alternatives",
    "exposed",
    "assumptions",
    "clarifications",
    "diagnostics",
    "summary"
  ],
  "properties": {
    "schemaVersion": { "const": "1" },
    "runId": { "type": "string" },
    "recipe": { "type": "object" },
    "status": { "enum": ["success", "degraded", "blocked", "cancelled", "failed"] },
    "alternatives": { "type": "array" },
    "exposed": { "type": "object" },
    "assumptions": { "type": "array" },
    "clarifications": { "type": "array" },
    "diagnostics": { "type": "array" },
    "summary": { "type": "object" }
  }
}
