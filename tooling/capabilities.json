  "capabilities": {
    "formatting": { "providers": ["prettier", "gofmt"], "costClass": "low", "contextClass": "low" },
    "static_lint": {
      "providers": ["eslint", "markdownlint", "shellcheck"],
      "costClass": "low",
      "contextClass": "low"
    },
    "schema_validation": { "providers": ["ajv"], "costClass": "low", "contextClass": "low" },
    "generated_drift": { "providers": ["cmp"], "costClass": "very_low", "contextClass": "low" },
    "compilation": { "providers": ["tsc", "go"], "costClass": "medium", "contextClass": "low" },
    "unit_testing": {
      "providers": ["vitest", "node-test", "go-test"],
      "costClass": "medium",
      "contextClass": "low"
    },
    "race_detection": { "providers": ["go-test"], "costClass": "high", "contextClass": "low" },
    "static_analysis": { "providers": ["go-vet"], "costClass": "low", "contextClass": "low" },
    "coverage_measurement": {
      "providers": ["vitest-v8"],
      "costClass": "high",
      "contextClass": "low"
    },
    "api_compatibility": {
      "providers": ["api-extractor", "public-exports"],
      "costClass": "medium",
      "contextClass": "low"
    },
    "task_execution": {
      "providers": ["pnpm", "node"],
      "costClass": "very_low",
      "contextClass": "low"
    },
    "textual_search": {
      "providers": ["rg", "grep"],
      "costClass": "very_low",
      "contextClass": "low"
    },
    "file_discovery": {
      "providers": ["fd", "find"],
      "costClass": "very_low",
      "contextClass": "low"
    },
    "structural_search": { "providers": ["ast-grep"], "costClass": "low", "contextClass": "low" },
    "data_flow_analysis": {
      "providers": ["codeql"],
      "costClass": "high",
      "contextClass": "low",
      "scope": "ci-only"
    },
    "symbol_definition": {
      "providers": ["scripts/lsp-query.mjs"],
      "costClass": "low",
      "contextClass": "low",
      "compilerAuthoritative": true
    },
    "symbol_references": {
      "providers": ["scripts/lsp-query.mjs"],
      "costClass": "low",
      "contextClass": "low",
      "compilerAuthoritative": true
    },
    "document_symbols": {
      "providers": ["scripts/lsp-query.mjs"],
      "costClass": "low",
      "contextClass": "low",
      "compilerAuthoritative": true
    },
    "structured_query": { "providers": ["jq"], "costClass": "very_low", "contextClass": "low" },
    "secret_detection": {
      "providers": ["gitleaks"],
      "costClass": "medium",
      "contextClass": "low",
      "requiredInCI": true
    },
    "benchmarking": {
      "providers": ["hyperfine"],
      "costClass": "medium",
      "contextClass": "low",
      "variance": "statistical"
    },
    "property_testing": {
      "providers": ["fast-check"],
      "costClass": "medium",
      "contextClass": "low",
      "replay": "seed-and-path"
    },
    "dead_code_analysis": {
      "providers": ["knip"],
      "costClass": "medium",
      "contextClass": "low"
    },
    "mutation_testing": {
      "providers": ["stryker"],
      "costClass": "high",
      "contextClass": "low",
      "incremental": true
    },
    "complexity_risk": {
      "providers": ["typescript-compiler-api"],
      "costClass": "medium",
      "contextClass": "low"
    },
    "event_observation": {
      "providers": ["watchexec", "entr"],
      "costClass": "low",
      "contextClass": "none",
      "delivery": "advisory"
    },
    "output_reduction": {
      "providers": ["scripts/tool-trace", "rtk"],
      "costClass": "very_low",
      "contextClass": "low"
    }
  },
  "executionRoles": {
    "discovery": [
      "textual_search",
      "file_discovery",
      "structural_search",
      "symbol_definition",
      "symbol_references",
      "document_symbols",
      "structured_query",
      "benchmarking",
      "event_observation",
      "output_reduction"
    ],
    "gate": [
      "formatting",
      "static_lint",
      "schema_validation",
      "generated_drift",
      "compilation",
      "unit_testing",
      "race_detection",
      "static_analysis",
      "coverage_measurement",
      "api_compatibility",
      "data_flow_analysis",
      "secret_detection",
      "property_testing",
      "dead_code_analysis",
      "mutation_testing",
      "complexity_risk"
    ],
    "orchestration": ["task_execution"]
  }
}
