{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "workspaces": {
    "packages/*": { "entry": ["src/index.ts"], "project": ["src/**/*.ts"] },
    "apps/runtime-node": { "entry": ["src/index.ts", "src/server.ts"], "project": ["src/**/*.ts"] },
    "apps/dashboard": {
      "entry": ["server.mjs", "public/app.js"],
      "project": ["**/*.mjs", "public/*.js"]
    }
  },
  "ignore": ["scripts/lsp-query.mjs"],
  "ignoreDependencies": ["@ast-grep/cli", "@microsoft/api-extractor", "typescript-language-server"],
  "ignoreBinaries": ["go", "gofmt", "shellcheck", "watchexec"]
}
