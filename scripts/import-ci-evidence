#!/usr/bin/env bash
set -euo pipefail

source_directory="${1:-}"
label="${2:-}"
[[ -d "$source_directory" && "$label" =~ ^[A-Za-z0-9._-]+$ ]] || {
  echo 'usage: scripts/import-ci-evidence TRACE_DIRECTORY LABEL' >&2
  exit 64
}
worktree_root="$(git rev-parse --show-toplevel)"
common_git_dir="$(git -C "$worktree_root" rev-parse --path-format=absolute --git-common-dir)"
shared_root="${PROMPTIRIS_REPOSITORY_ROOT:-${common_git_dir%/.git}}"
imports_root="$shared_root/.agent/imports"
destination="$imports_root/$label/traces"
[[ ! -e "$destination" ]] || {
  echo "CI evidence already imported: $destination" >&2
  exit 73
}
mkdir -p "$imports_root"
temporary_root="$(mktemp -d "$imports_root/.pending-$label.XXXXXX")"
trap 'rm -rf "$temporary_root"' EXIT
temporary_destination="$temporary_root/traces"
mkdir -p "$temporary_destination"
count=0
while IFS= read -r trace; do
  version="$(jq -r '.schemaVersion // 0' "$trace")"
  [[ "$version" == 2 || "$version" == 3 ]] || continue
  cp "$trace" "$temporary_destination/$count-$(basename "$trace")"
  count=$((count + 1))
done < <(find "$source_directory" -type f -name '*.json' -print | LC_ALL=C sort)
if (( count == 0 )); then
  echo 'no schema-v2 Tool Traces found' >&2
  exit 65
fi
[[ ! -e "$destination" ]] || {
  echo "CI evidence already imported: $destination" >&2
  exit 73
}
mkdir -p "$(dirname "$destination")"
mv "$temporary_destination" "$destination"
trap - EXIT
rmdir "$temporary_root"
echo "imported $count local CI Tool Traces: $destination"
