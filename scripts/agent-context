#!/usr/bin/env bash
set -euo pipefail

worktree_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
common_git_dir="$(git -C "$worktree_root" rev-parse --path-format=absolute --git-common-dir 2>/dev/null || true)"
shared_root="${PROMPTIRIS_REPOSITORY_ROOT:-${common_git_dir%/.git}}"
[[ -n "$shared_root" && -d "$shared_root" ]] || shared_root="$worktree_root"
agent_root="${PROMPTIRIS_AGENT_ROOT:-$shared_root/.agent}"
branch="$(git -C "$worktree_root" branch --show-current 2>/dev/null || true)"
head="$(git -C "$worktree_root" rev-parse --short HEAD 2>/dev/null || echo none)"
upstream="$(git -C "$worktree_root" rev-parse --abbrev-ref '@{upstream}' 2>/dev/null || echo none)"
base_revision="$(git -C "$worktree_root" merge-base HEAD origin/main 2>/dev/null || git -C "$worktree_root" rev-parse HEAD 2>/dev/null || echo none)"

packet=''
if [[ -n "$branch" ]]; then
  packet="$(rg -l --fixed-strings "Branch: \`$branch\`" "$worktree_root/.scratch" 2>/dev/null | LC_ALL=C sort | head -1 || true)"
fi
packet="${packet#"$worktree_root/"}"
claim_file="$agent_root/claims/$branch.json"

echo '## REPOSITORY'
printf 'shared-root: %s\nworktree: %s\nbranch: %s\nhead: %s\nbase: %s\nupstream: %s\n' \
  "$shared_root" "$worktree_root" "${branch:-detached}" "$head" "${base_revision:0:12}" "$upstream"
if [[ "$worktree_root" == "$shared_root" && "$branch" != main ]]; then
  echo 'warning: a feature branch occupies the integration checkout'
fi

echo
echo '## WORK ITEM'
if [[ -n "$packet" ]]; then
  printf 'packet: %s\n' "$packet"
  sed -n -e 's/^Status: /status: /p' -e 's/^GitHub issue: /issue: /p' -e 's/^Blocked by: /blocked-by: /p' "$worktree_root/$packet"
else
  echo 'none matched to branch'
fi
if [[ -f "$claim_file" ]]; then
  jq '{taskId,agentId,stage,branch,worktree,candidateRevision,claimedAt}' "$claim_file"
else
  echo 'lease: none'
fi

echo
echo '## WORKTREES'
git -C "$worktree_root" worktree list --porcelain 2>/dev/null | awk '
  /^worktree / { path=substr($0,10) }
  /^HEAD / { head=substr($0,6,12) }
  /^branch / { branch=$0; sub("refs/heads/", "", branch); sub("^branch ", "", branch); printf "%s\t%s\t%s\n", branch, head, path }
' | head -12

echo
echo '## CLAIMS'
claim_files=("$agent_root"/claims/*.json)
if [[ -e "${claim_files[0]}" ]]; then
  jq -s -r '.[] | "\(.branch)\t\(.agentId)\t\(.stage)\t\(.worktree)"' "${claim_files[@]}" | LC_ALL=C sort
  conflicts="$(jq -s -r 'group_by(.worktree)[] | select(length > 1) | .[0].worktree' "${claim_files[@]}")"
  if [[ -n "$conflicts" ]]; then
    printf 'warning: multiple claims share a mutable worktree:\n%s\n' "$conflicts"
  fi
else
  echo 'none'
fi

echo
echo '## STATUS'
git -C "$worktree_root" status --short | head -30 || true

echo
echo '## RECENT COMMITS'
git -C "$worktree_root" log --oneline -5 2>/dev/null || true

echo
echo '## CHANGE SUMMARY'
git -C "$worktree_root" diff --stat "$base_revision" 2>/dev/null | head -40 || true

echo
echo '## ACTIVE WORK'
if [[ -f "$claim_file" ]]; then
  jq '{taskId,agentId,stage,candidateRevision,claimedAt}' "$claim_file"
else
  echo 'none for this branch'
fi

echo
echo '## LAST VERIFICATION'
last_trace="$(node -e '
  const fs = require("node:fs");
  const path = require("node:path");
  const directory = process.argv[1];
  try {
    const files = fs.readdirSync(directory).filter((file) => file.endsWith(".json"));
    files.sort((left, right) => fs.statSync(path.join(directory, right)).mtimeMs - fs.statSync(path.join(directory, left)).mtimeMs);
    process.stdout.write(files[0] ? path.join(directory, files[0]) : "");
  } catch {}
' "$agent_root/traces")"
if [[ -n "$last_trace" ]]; then
  jq '{taskId,provider:(.providerId // .command),exitCode,durationMs,context,evidenceRef:(.evidence.ref // .rawEvidenceRef)}' "$last_trace"
else
  echo 'none'
fi

echo
echo '## TELEMETRY'
if [[ -f "$agent_root/reports/telemetry-summary.json" ]]; then
  jq '{generatedAt,summary:{traceCount:.summary.traceCount,failedTraceCount:.summary.failedTraceCount,durationMs:.summary.durationMs,reducedBytes:.summary.reducedBytes,estimatedTokensAvoided:.summary.estimatedTokensAvoided,latestVerification:.summary.latestVerification},dataQuality:{worktreeCount:.dataQuality.worktreeCount,agentCount:.dataQuality.agentCount,unattributedTraceCount:.dataQuality.unattributedTraceCount},quality:{mutation:{score:.quality.mutation.score,status:.quality.mutation.policy.status,unresolved:.quality.mutation.debt.unresolved,ignored:.quality.mutation.debt.ignored},crapViolations:.quality.crap.violationCount}}' "$agent_root/reports/telemetry-summary.json"
else
  echo 'none; run pnpm telemetry:analyze'
fi

echo
echo '## CAPABILITIES'
jq -r '.capabilities | to_entries[] | "\(.key): \(.value.providers | join(", "))"' "$worktree_root/tooling/capabilities.json"
