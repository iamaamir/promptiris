#!/usr/bin/env bash
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
cd "$repo_root"
echo '## REPOSITORY'
printf 'root: %s\nhead: %s\n' "$repo_root" "$(git rev-parse --short HEAD 2>/dev/null || echo none)"
echo
echo '## STATUS'
git status --short | head -30 || true
echo
echo '## RECENT COMMITS'
git log --oneline -5 2>/dev/null || true
echo
echo '## CHANGE SUMMARY'
git diff --stat | head -40 || true
echo
echo '## ACTIVE WORK'
state_file="$(find .agent/work -mindepth 2 -maxdepth 2 -name state.json -print 2>/dev/null | sort | tail -1)"
if [[ -n "$state_file" ]]; then jq '{task_id,goal,stage,iteration,last_verification,next_action,lease}' "$state_file"; else echo 'none'; fi
echo
echo '## LAST VERIFICATION'
last_trace="$(find .agent/traces -maxdepth 1 -name '*.json' -print 2>/dev/null | sort | tail -1)"
if [[ -n "$last_trace" ]]; then
  jq '{taskId,provider:(.providerId // .command),exitCode,durationMs,evidenceRef:(.evidence.ref // .rawEvidenceRef)}' "$last_trace"
else
  echo 'none'
fi
echo
echo '## TELEMETRY'
if [[ -f .agent/reports/telemetry-summary.json ]]; then
  jq '{generatedAt,summary:{traceCount:.summary.traceCount,failedTraceCount:.summary.failedTraceCount,durationMs:.summary.durationMs,reducedBytes:.summary.reducedBytes,estimatedTokensAvoided:.summary.estimatedTokensAvoided,latestVerification:.summary.latestVerification},quality:{mutation:{score:.quality.mutation.score,status:.quality.mutation.policy.status,unresolved:.quality.mutation.debt.unresolved,ignored:.quality.mutation.debt.ignored,weakestTarget:(.quality.mutation.targets|max_by(.debt)|{file,score,debt})},typescriptCoverage:.quality.coverage.statements.percent,goCoverage:.quality.goCoverage.percent,crapViolations:.quality.crap.violationCount}}' .agent/reports/telemetry-summary.json
else
  echo 'none; run pnpm telemetry:analyze'
fi
echo
echo '## CAPABILITIES'
jq -r '.capabilities | to_entries[] | "\(.key): \(.value.providers | join(", "))"' tooling/capabilities.json
