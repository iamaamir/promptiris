#!/usr/bin/env bash
set -euo pipefail
repo_root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"
trace_dir="${1:-$repo_root/.agent/traces}"
traces=()
while IFS= read -r trace; do traces+=("$trace"); done < <(find "$trace_dir" -maxdepth 1 -name '*.json' -type f -print 2>/dev/null | sort)
if ((${#traces[@]} == 0)); then
  echo '{"schemaVersion":1,"candidates":[]}'
  exit 0
fi
jq -s '{schemaVersion:2,candidates:(map({taskId,provider:(.providerId // .command // "unknown"),durationMs,rawBytes:(.output.rawBytes // .rawOutputBytes // 0),reducedBytes:(.output.reducedBytes // 0),evidenceRef:(.evidence.ref // .rawEvidenceRef)}) | group_by([.taskId,.provider]) | map(select(length >= 3) | {taskId:.[0].taskId,provider:.[0].provider,observations:length,totalDurationMs:(map(.durationMs)|add),totalRawBytes:(map(.rawBytes)|add),totalReducedBytes:(map(.reducedBytes)|add),evidence:map(.evidenceRef)}) | sort_by(-.observations))}' "${traces[@]}"
