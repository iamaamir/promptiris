#!/usr/bin/env node
import { execFileSync } from 'node:child_process';
import { randomUUID } from 'node:crypto';
import {
  chmod,
  copyFile,
  lstat,
  mkdir,
  readFile,
  rename,
  rm,
  stat,
  writeFile,
} from 'node:fs/promises';
import { basename, dirname, join, relative, resolve } from 'node:path';
import {
  ROLE_NAMES,
  authoritativeAttempts,
  deriveAttackSurfaces,
  digestBytes,
  digestJson,
  replayLedger,
  validateAttestation,
  withoutKey,
} from '../tooling/quality/role-evidence-policy.mjs';

const modes = Object.freeze(['prepare', 'record', 'unsupported', 'external', 'status']);
const modelClasses = Object.freeze(['quick', 'general', 'frontier']);
const sourceAccess = Object.freeze({
  reviewer: 'contract-diff',
  hardener: 'attack-surfaces',
  qa: 'source-blind-bundle',
});

class RoleError extends Error {
  constructor(code, message, evidenceRef, nextCommand) {
    super(message);
    this.code = code;
    this.evidenceRef = evidenceRef;
    this.nextCommand = nextCommand;
  }
}

const fail = ({ code, message, evidenceRef = 'none', nextCommand }) => {
  process.stderr.write(`${code}: ${message}\n`);
  process.stderr.write(`Evidence: ${evidenceRef}\n`);
  process.stderr.write(`Next: ${nextCommand}\n`);
  process.exitCode = 1;
};

const git = (root, arguments_) =>
  execFileSync('git', arguments_, { cwd: root, encoding: 'utf8' }).trim();

const readJson = async (path) => JSON.parse(await readFile(path, 'utf8'));

const atomicJson = async (path, value) => {
  await mkdir(dirname(path), { recursive: true });
  const temporaryPath = `${path}.${process.pid}.${randomUUID()}.tmp`;
  await writeFile(temporaryPath, `${JSON.stringify(value, null, 2)}\n`);
  await rename(temporaryPath, path);
};

const repository = () => {
  const root = resolve('.');
  const commonGitDirectory = git(root, ['rev-parse', '--path-format=absolute', '--git-common-dir']);
  const sharedRoot = commonGitDirectory.endsWith('/.git') ? commonGitDirectory.slice(0, -5) : root;
  return {
    root,
    sharedRoot,
    agentRoot: process.env.PROMPTIRIS_AGENT_ROOT ?? join(sharedRoot, '.agent'),
    branch: git(root, ['branch', '--show-current']),
  };
};

const findPacket = ({ root, branch }) => {
  const output = execFileSync(
    'rg',
    ['-l', '--fixed-strings', `Branch: \`${branch}\``, '.scratch'],
    {
      cwd: root,
      encoding: 'utf8',
    },
  );
  const packets = output.trim().split('\n').filter(Boolean).sort();
  if (packets.length !== 1) {
    throw new RoleError(
      'ROLE_PACKET_AMBIGUOUS',
      `branch ${branch} must own exactly one Work Item; found ${packets.length}`,
      '.scratch',
      'scripts/agent-context',
    );
  }
  return packets[0];
};

const candidateManifest = async (context, packet) => {
  const path = join(context.agentRoot, 'reports', 'candidates', `${context.branch}.json`);
  try {
    execFileSync(process.execPath, ['scripts/finalize-candidate.mjs', 'check', packet], {
      cwd: context.root,
      env: { ...process.env, PROMPTIRIS_AGENT_ROOT: context.agentRoot },
      stdio: ['ignore', 'ignore', 'ignore'],
    });
    return { path, value: await readJson(path) };
  } catch {
    throw new RoleError(
      'ROLE_CANDIDATE_NOT_FROZEN',
      'role execution requires a clean, finalized Candidate',
      path,
      `pnpm candidate:finalize -- ${packet}`,
    );
  }
};

const roleDirectory = (context, candidateRevision) =>
  join(
    context.agentRoot,
    'role-attempts',
    context.branch,
    candidateRevision.replace('sha256:', ''),
  );

const loadLedger = async (path, context, packet, candidate) => {
  try {
    return await readJson(path);
  } catch {
    return {
      schemaVersion: 1,
      taskId: packet,
      branch: context.branch,
      candidateRevision: candidate.candidateRevision,
      entries: [],
      attestations: [],
      unsupported: [],
    };
  }
};

const withLedgerLock = async (directory, operation) => {
  const lock = `${directory}.lock`;
  try {
    await mkdir(lock, { recursive: false });
  } catch {
    try {
      const age = Date.now() - (await stat(lock)).mtimeMs;
      if (age <= 300_000) throw new Error('active');
      await rm(lock, { recursive: true });
      await mkdir(lock, { recursive: false });
    } catch {
      throw new RoleError(
        'ROLE_LEDGER_LOCKED',
        'another role writer owns the append-only ledger lock',
        lock,
        'wait for the active writer, then run scripts/agent-role status',
      );
    }
  }
  try {
    return await operation();
  } finally {
    await rm(lock, { recursive: true });
  }
};

const appendEntry = (ledger, entry) => {
  const next = { ...entry, sequence: ledger.entries.length + 1 };
  const entries = [...ledger.entries, next];
  const replay = replayLedger(entries, ledger.candidateRevision);
  if (replay.failures.length > 0) {
    throw new RoleError(
      'ROLE_LEDGER_INVALID',
      replay.failures.join('; '),
      'role-ledger.json',
      'scripts/agent-role status',
    );
  }
  return { ...ledger, entries };
};

const currentAttempt = (ledger, attemptId) => {
  const matches = ledger.entries.filter((entry) => entry.attemptId === attemptId);
  return matches.at(-1);
};

const candidateDiff = (context, candidate) =>
  execFileSync(
    'git',
    [
      'diff',
      '--binary',
      '--no-ext-diff',
      candidate.baseRevision,
      'HEAD',
      '--',
      '.',
      ':(exclude).scratch/**/*.evidence/**',
    ],
    { cwd: context.root },
  );

const changedPaths = (context, candidate) =>
  git(context.root, [
    'diff',
    '--name-only',
    candidate.baseRevision,
    'HEAD',
    '--',
    '.',
    ':(exclude).scratch/**/*.evidence/**',
  ])
    .split('\n')
    .filter(Boolean)
    .sort();

const stateReference = (context, path) => relative(context.sharedRoot, path);

const resolvedInputPath = (context, reference) =>
  reference.startsWith('.agent/')
    ? resolve(context.sharedRoot, reference)
    : resolve(context.root, reference);

const trackedTypeScriptSources = async (context) => {
  const paths = git(context.root, ['ls-files', '*.ts', '*.tsx', '*.mts', '*.cts'])
    .split('\n')
    .filter(Boolean);
  return new Map(
    await Promise.all(
      paths.map(async (path) => [path, await readFile(join(context.root, path), 'utf8')]),
    ),
  );
};

const writeHardenerSurfaces = async (context, directory, paths) => {
  const surfacePath = join(directory, 'attack-surfaces.json');
  const surfaces = deriveAttackSurfaces(await trackedTypeScriptSources(context), paths);
  await atomicJson(surfacePath, { schemaVersion: 1, complete: true, surfaces });
  return {
    kind: 'attack-surfaces',
    ref: stateReference(context, surfacePath),
    digest: digestBytes(await readFile(surfacePath)),
    surfaces,
  };
};

const qaAllowedPath = (path) =>
  /^(?:README\.md|PRODUCT\.md|CONTRIBUTING\.md|spec\/schemas\/|packages\/[^/]+\/etc\/)/.test(
    path,
  ) && !/(?:^|\/)src(?:\/|$)|(?:^|\/)\.git(?:\/|$)/.test(path);

const writeQaBundle = async (context, directory) => {
  const bundleRoot = join(directory, 'qa-bundle');
  const paths = git(context.root, ['ls-files']).split('\n').filter(qaAllowedPath).sort();
  const files = [];
  for (const path of paths) {
    const source = join(context.root, path);
    const metadata = await lstat(source);
    if (metadata.isSymbolicLink() || !metadata.isFile()) {
      throw new RoleError(
        'ROLE_QA_BUNDLE_UNSAFE',
        `QA input is not a regular file: ${path}`,
        path,
        'remove the unsafe public artifact and rerun prepare',
      );
    }
    const destination = join(bundleRoot, path);
    await mkdir(dirname(destination), { recursive: true });
    await copyFile(source, destination);
    await chmod(destination, 0o444);
    files.push({ path, digest: digestBytes(await readFile(source)) });
  }
  await chmod(bundleRoot, 0o555);
  const capabilities = {
    sourceExcluded: true,
    gitMetadataExcluded: true,
    symlinksRejected: true,
    readOnlyFiles: true,
    emptyEnvironment: false,
    networkDisabled: false,
    ambientFilesystemDisabled: false,
  };
  const bundle = { root: 'qa-bundle', files, capabilities };
  return {
    kind: 'source-blind-bundle',
    ref: stateReference(context, bundleRoot),
    digest: digestJson(bundle),
    bundle,
  };
};

const inputReference = async (kind, ref, path) => ({
  kind,
  ref,
  digest: digestBytes(await readFile(path)),
});

const prepareInputs = async (context, candidate, packet, role, directory) => {
  const packetInput = await inputReference('work-item', packet, join(context.root, packet));
  const diffPath = join(directory, 'candidate.diff');
  await mkdir(directory, { recursive: true });
  await writeFile(diffPath, candidateDiff(context, candidate));
  const diffInput = await inputReference(
    'candidate-diff',
    stateReference(context, diffPath),
    diffPath,
  );
  if (role === 'reviewer') return [packetInput, diffInput];
  if (role === 'hardener') {
    return [
      packetInput,
      diffInput,
      await writeHardenerSurfaces(context, directory, changedPaths(context, candidate)),
    ];
  }
  return [await writeQaBundle(context, directory)];
};

const prepare = async (context, role, arguments_) => {
  const [producerId, modelClass, parentInvocationId] = arguments_;
  if (!producerId || !modelClasses.includes(modelClass) || !parentInvocationId) {
    throw new RoleError(
      'ROLE_PREPARE_USAGE',
      'prepare requires producer identity, model class, and parent invocation ID',
      'none',
      `scripts/agent-role prepare ${role} <producer-id> <quick|general|frontier> <parent-id>`,
    );
  }
  const packet = findPacket(context);
  const { value: candidate } = await candidateManifest(context, packet);
  const claim = await readJson(join(context.agentRoot, 'claims', `${context.branch}.json`));
  if (claim.agentId === producerId) {
    throw new RoleError(
      'ROLE_SELF_ASSIGNMENT',
      'the claimed Implementer cannot produce an independent role',
      join(context.agentRoot, 'claims', `${context.branch}.json`),
      `dispatch a distinct agent, then rerun scripts/agent-role prepare ${role}`,
    );
  }
  const registry = await readJson(join(context.root, 'tooling/roles/registry.json'));
  const registration = registry.roles[role];
  const promptBytes = await readFile(join(context.root, registration.prompt));
  const promptDigest = digestBytes(promptBytes);
  if (registration.promptDigest && registration.promptDigest !== promptDigest) {
    throw new RoleError(
      'ROLE_PROMPT_DRIFT',
      `${role} prompt bytes do not match the registered digest`,
      registration.prompt,
      'review the prompt change and update tooling/roles/registry.json',
    );
  }
  const attemptId = `attempt-${randomUUID()}`;
  const directory = join(roleDirectory(context, candidate.candidateRevision), attemptId);
  const evidenceDirectory = join(dirname(packet), `${basename(packet, '.md')}.evidence`);
  const manifestBase = {
    schemaVersion: 1,
    attemptId,
    parentInvocationId,
    taskId: packet,
    baseRevision: candidate.baseRevision,
    candidateRevision: candidate.candidateRevision,
    implementerId: claim.agentId,
    producerId,
    role,
    modelClass,
    promptId: registration.promptId,
    promptRef: registration.prompt,
    promptDigest,
    sourceAccessMode: sourceAccess[role],
    inputs: await prepareInputs(context, candidate, packet, role, directory),
  };
  const manifest = { ...manifestBase, manifestDigest: digestJson(manifestBase) };
  const manifestPath = join(
    context.root,
    evidenceDirectory,
    'role-protocol',
    attemptId,
    'input-manifest.json',
  );
  await atomicJson(manifestPath, manifest);
  const ledgerPath = join(roleDirectory(context, candidate.candidateRevision), 'ledger.json');
  await withLedgerLock(dirname(ledgerPath), async () => {
    let ledger = await loadLedger(ledgerPath, context, packet, candidate);
    const reserved = {
      schemaVersion: 1,
      attemptId,
      parentInvocationId,
      implementerId: claim.agentId,
      producerId,
      role,
      promptId: registration.promptId,
      promptDigest,
      modelClass,
      candidateRevision: candidate.candidateRevision,
      inputManifestRef: relative(context.root, manifestPath),
      inputManifestDigest: manifest.manifestDigest,
      sourceAccessMode: sourceAccess[role],
      state: 'reserved',
      attestationStrength: 'host-attested',
      toolTraceRefs: [],
      unresolvedFindingCount: 0,
      recordedAt: new Date().toISOString(),
    };
    ledger = appendEntry(ledger, reserved);
    ledger = appendEntry(ledger, {
      ...reserved,
      state: 'running',
      recordedAt: new Date().toISOString(),
    });
    await atomicJson(ledgerPath, ledger);
  });
  process.stdout.write(
    `${JSON.stringify({
      attemptId,
      manifestRef: manifestPath,
      inputRoots: {
        repository: context.root,
        agentState: context.sharedRoot,
      },
      resolvedInputs: manifest.inputs.map(({ kind, ref, digest }) => ({
        kind,
        ref,
        digest,
        path: resolvedInputPath(context, ref),
      })),
      next: `run ${role} using only the resolved inputs, then record its attestation and report`,
    })}\n`,
  );
};

const record = async (context, role, arguments_) => {
  const [attemptId, state, findingCountText = '0'] = arguments_;
  if (!['failed', 'invalidated', 'superseded'].includes(state)) {
    throw new RoleError(
      'ROLE_TRANSITION_RESERVED',
      'record may only close, invalidate, or supersede an attempt; binding owns completion',
      'none',
      `scripts/agent-role record ${role} ${attemptId} <failed|invalidated|superseded> <finding-count>`,
    );
  }
  const packet = findPacket(context);
  const { value: candidate } = await candidateManifest(context, packet);
  const directory = roleDirectory(context, candidate.candidateRevision);
  const ledgerPath = join(directory, 'ledger.json');
  await withLedgerLock(directory, async () => {
    let ledger = await loadLedger(ledgerPath, context, packet, candidate);
    const previous = currentAttempt(ledger, attemptId);
    if (!previous || previous.role !== role) {
      throw new RoleError(
        'ROLE_ATTEMPT_MISSING',
        `no ${role} attempt matches ${attemptId}`,
        ledgerPath,
        `scripts/agent-role prepare ${role} <producer-id> <model-class> <parent-id>`,
      );
    }
    const unresolvedFindingCount = Number(findingCountText);
    if (!Number.isSafeInteger(unresolvedFindingCount) || unresolvedFindingCount < 0) {
      throw new RoleError(
        'ROLE_FINDING_COUNT_INVALID',
        'finding count must be a non-negative integer',
        'none',
        `scripts/agent-role record ${role} ${attemptId} ${state} <finding-count>`,
      );
    }
    ledger = appendEntry(ledger, {
      ...previous,
      state,
      unresolvedFindingCount,
      recordedAt: new Date().toISOString(),
    });
    await atomicJson(ledgerPath, ledger);
  });
  process.stdout.write(`${attemptId}: ${state}\n`);
};

const recordUnsupported = async (context, role, reasonParts) => {
  const packet = findPacket(context);
  const { value: candidate } = await candidateManifest(context, packet);
  const directory = roleDirectory(context, candidate.candidateRevision);
  const ledgerPath = join(directory, 'ledger.json');
  const reason = reasonParts.join(' ').trim();
  if (!reason) {
    throw new RoleError(
      'ROLE_UNSUPPORTED_REASON_REQUIRED',
      'unsupported capability requires a concrete Host limitation',
      'none',
      `scripts/agent-role unsupported ${role} <reason>`,
    );
  }
  await withLedgerLock(directory, async () => {
    const ledger = await loadLedger(ledgerPath, context, packet, candidate);
    await atomicJson(ledgerPath, {
      ...ledger,
      unsupported: [...ledger.unsupported, { role, reason, recordedAt: new Date().toISOString() }],
    });
  });
  process.stdout.write('needs-independent-roles\n');
};

const recordExternalAttestation = async (context, role, [envelopePath]) => {
  if (!envelopePath) {
    throw new RoleError(
      'ROLE_ATTESTATION_REQUIRED',
      'external requires an attestation envelope path',
      'none',
      `scripts/agent-role external ${role} <attestation.json>`,
    );
  }
  const packet = findPacket(context);
  const { value: candidate } = await candidateManifest(context, packet);
  const directory = roleDirectory(context, candidate.candidateRevision);
  const ledgerPath = join(directory, 'ledger.json');
  await withLedgerLock(directory, async () => {
    const ledger = await loadLedger(ledgerPath, context, packet, candidate);
    const envelope = await readJson(resolve(envelopePath));
    const attempt = currentAttempt(ledger, envelope.attemptId);
    if (!attempt || attempt.role !== role) {
      throw new RoleError(
        'ROLE_ATTESTATION_ATTEMPT_MISSING',
        'attestation does not identify a current role attempt',
        envelopePath,
        `scripts/agent-role prepare ${role} <producer-id> <model-class> <parent-id>`,
      );
    }
    const registry = await readJson(join(context.root, 'tooling/roles/registry.json'));
    const failures = validateAttestation(envelope, attempt, registry);
    if (ledger.attestations.some(({ nonce }) => nonce === envelope.nonce)) {
      failures.push('attestation nonce was already used');
    }
    if (failures.length > 0) {
      throw new RoleError(
        'ROLE_ATTESTATION_INVALID',
        failures.join('; '),
        envelopePath,
        `obtain a fresh registered attestation for ${attempt.attemptId}`,
      );
    }
    const proofPath = resolve(context.root, envelope.nativeProofRef);
    if (digestBytes(await readFile(proofPath)) !== envelope.nativeProofDigest) {
      throw new RoleError(
        'ROLE_NATIVE_PROOF_MISMATCH',
        'native proof bytes do not match the attestation digest',
        envelope.nativeProofRef,
        'regenerate the Host attestation from the original native proof',
      );
    }
    const evidenceDirectory = join(dirname(packet), `${basename(packet, '.md')}.evidence`);
    const storedPath = join(
      context.root,
      evidenceDirectory,
      'role-protocol',
      attempt.attemptId,
      'attestation.json',
    );
    await atomicJson(storedPath, envelope);
    await atomicJson(ledgerPath, {
      ...ledger,
      attestations: [
        ...ledger.attestations,
        {
          attemptId: attempt.attemptId,
          nonce: envelope.nonce,
          ref: relative(context.root, storedPath),
          digest: digestBytes(await readFile(storedPath)),
        },
      ],
    });
  });
  process.stdout.write(`${envelopePath}\n`);
};

const status = async (context) => {
  const packet = findPacket(context);
  let candidate;
  try {
    ({ value: candidate } = await candidateManifest(context, packet));
  } catch (error) {
    if (!(error instanceof RoleError)) throw error;
    process.stdout.write(
      `${JSON.stringify({ state: 'candidate-not-frozen', missingRoles: ROLE_NAMES, nextActions: [error.nextCommand] }, null, 2)}\n`,
    );
    return;
  }
  const directory = roleDirectory(context, candidate.candidateRevision);
  const ledger = await loadLedger(join(directory, 'ledger.json'), context, packet, candidate);
  const result = authoritativeAttempts(ledger.entries, candidate.candidateRevision);
  const missingRoles = ROLE_NAMES.filter((role) => !result.attempts.has(role));
  const nextActions = missingRoles.map(
    (role) =>
      `scripts/agent-role prepare ${role} <producer-id> <quick|general|frontier> <parent-id>`,
  );
  process.stdout.write(
    `${JSON.stringify(
      {
        state:
          ledger.unsupported.length > 0
            ? 'needs-independent-roles'
            : missingRoles.length > 0
              ? 'roles-incomplete'
              : 'roles-complete',
        candidateRevision: candidate.candidateRevision,
        completedRoles: [...result.attempts.keys()],
        missingRoles,
        ledgerFailures: result.failures,
        unsupported: ledger.unsupported,
        nextActions,
      },
      null,
      2,
    )}\n`,
  );
};

const main = async () => {
  const [mode, role, ...arguments_] = process.argv.slice(2);
  if (!modes.includes(mode)) {
    throw new RoleError(
      'ROLE_USAGE',
      'expected a supported role command',
      'none',
      'scripts/agent-role <prepare|record|unsupported|external|status> [role]',
    );
  }
  if (mode !== 'status' && !ROLE_NAMES.includes(role)) {
    throw new RoleError(
      'ROLE_UNKNOWN',
      `unknown role: ${role ?? 'missing'}`,
      'none',
      `scripts/agent-role ${mode} <reviewer|hardener|qa>`,
    );
  }
  const context = repository();
  if (mode === 'prepare') await prepare(context, role, arguments_);
  else if (mode === 'record') await record(context, role, arguments_);
  else if (mode === 'unsupported') await recordUnsupported(context, role, arguments_);
  else if (mode === 'external') await recordExternalAttestation(context, role, arguments_);
  else await status(context);
};

try {
  await main();
} catch (error) {
  fail(
    error instanceof RoleError
      ? error
      : new RoleError(
          'ROLE_RUNTIME',
          error instanceof Error ? error.message : String(error),
          'none',
          'scripts/agent-role status',
        ),
  );
}
