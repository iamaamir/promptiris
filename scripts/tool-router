#!/usr/bin/env bash
set -euo pipefail
root="$(git rev-parse --show-toplevel 2>/dev/null || pwd)"; registry="${TOOL_REGISTRY:-$root/tooling/capabilities.json}"; cd "$root"
capability="${1:-}"; [[ -n "$capability" ]] || { echo 'usage: tool-router CAPABILITY [-- ARG...]' >&2; exit 64; }
shift
command -v jq >/dev/null 2>&1 || { echo 'jq is required to route capabilities' >&2; exit 69; }
providers="$(jq -r --arg c "$capability" '.capabilities[$c].providers[]? // empty' "$registry")"
[[ -n "$providers" ]] || { echo "unknown capability: $capability" >&2; exit 64; }
provider=""
while IFS= read -r candidate; do
  if command -v "$candidate" >/dev/null 2>&1; then provider="$candidate"; break; fi
done <<< "$providers"
[[ -n "$provider" ]] || { echo "no available provider for capability: $capability" >&2; exit 69; }
if (( $# == 0 )); then echo "$provider"; exit 0; fi
[[ "$1" == "--" ]] || { echo 'arguments must follow --' >&2; exit 64; }
shift
exec ./scripts/tool-trace \
  --task "capability.$capability" \
  --provider capability-router \
  --tools "$provider" \
  -- "$provider" "$@"
